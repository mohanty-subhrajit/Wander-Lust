<%-layout("/layouts/boilerplate")%>
<script>
  const mapToken = "<%= process.env.MAP_TOKEN %>";
</script>
<div class="row ">
<div class="col-12 col-md-10 offset-md-1 col-lg-8 offset-lg-2">
  <body>
    <br><br>
    <h3>Create a New Listing</h3>
    <form method="POST" action="/listings" class="needs-validation" novalidate enctype="multipart/form-data">
        <div class="mb-3">
        <label for="title" class="form-label">Title</label>
      <input name="listing[title]" placeholder="Add a catchy title" type="text" class="form-control" required />
          <div class="valid-feedback">Title looks good</div>
          <div class="invalid-feedback">Please Give a Title</div>
        </div>
    
      <div class="mb-3">
        <label for="description" class="form-label">Description</label>
        <textarea
        name="listing[description]"
        placeholder="enter description" class="form-control"  required
      ></textarea>
      <div class="valid-feedback">descripction looks good</div>
          <div class="invalid-feedback">Please  Enter Descripction</div>
      </div>
     

     <div class="mb-3">
          <label for="image" class="form-label">Upload Image </label>
         <input
        name="listing[image]"
       class="form-control" 
        type="file"
        required
         
      />
      
          <div class="invalid-feedback"> Default Imgae will be set</div>
     </div>

     <div class="row">
         <div class="mb-3 col-md-4">
      <label for="price" class="form-label">Price (₹ per night)</label>
      <input name="listing[price]" placeholder="Min ₹300" type="number" class="form-control" min="300" required/>
      <div class="valid-feedback">price looks good</div>
          <div class="invalid-feedback">Price must be at least ₹300</div>
      </div>
      
      <div class="mb-3 col-md-8">
        <label for="country" class="form-label">Country</label>
        <input name="listing[country]" placeholder="India" type="text"  class="form-control"  required/>
        <div class="valid-feedback"></div>
          <div class="invalid-feedback">Please enter a country name</div>

      </div>
     </div>
     
      
      
     <div class="mb-3">
        <label for="location" class="form-label">Location</label>
        <div class="input-group mb-2">
          <input
            id="location"
            name="listing[location]"
            placeholder="Bhubaneswar"
            type="text"
            class="form-control"
            required
          />
        </div>
        <div class="valid-feedback">Location looks good</div>
        <div class="invalid-feedback">Please give a location</div>

        <!-- Location Options -->
        <div class="row mt-2">
          <div class="col-md-6">
            <button type="button" id="useCurrentLocation" class="btn btn-info btn-sm w-100">
              <i class="fa-solid fa-location-dot"></i> Use Current Location
            </button>
          </div>
          <div class="col-md-6">
            <button type="button" class="btn btn-primary btn-sm w-100" data-bs-toggle="collapse" data-bs-target="#googleLocationCollapse">
              <i class="fa-brands fa-google"></i> Google Maps Location
            </button>
          </div>
        </div>

        <!-- Google Location Input (Hidden by default) -->
        <div class="collapse mt-2" id="googleLocationCollapse">
          <div class="card card-body">
            <label class="form-label">Paste Google Maps URL or Coordinates</label>
            <div class="input-group mb-2">
              <input
                type="text"
                id="googleLocationInput"
                class="form-control"
                placeholder="Example: https://www.google.com/maps/@20.1234,-85.8246 OR 20.1234,-85.8246"
              />
              <button type="button" id="useGoogleLocation" class="btn btn-primary">
                <i class="fa-solid fa-check"></i> Use This
              </button>
            </div>
            <small class="form-text text-muted">
              <strong>How to use:</strong><br>
              1. Open Google Maps, find your property<br>
              2. Copy the URL from address bar<br>
              3. Paste it in the field above<br>
              OR paste coordinates in format: 20.1234,-85.8246
            </small>
          </div>
        </div>
     </div>

     <div class="mb-3">
        <label for="category" class="form-label">Category</label>
        <select name="listing[category]" class="form-select" required>
          <option value="" selected disabled>Select a category</option>
          <option value="Rooms">Rooms</option>
          <option value="Iconic cities">Iconic Cities</option>
          <option value="mountains">Mountains</option>
          <option value="castles">Castles</option>
          <option value="Amazing Pools">Amazing Pools</option>
          <option value="camping">Camping</option>
          <option value="farms">Farms</option>
          <option value="Arctic">Arctic</option>
          <option value="Boats House">Boats House</option>
        </select>
        <div class="valid-feedback">Category looks good</div>
        <div class="invalid-feedback">Please select a category</div>
        <small class="form-text text-muted">Note: Your listing will automatically become "Trending" after receiving 2 or more bookings!</small>
     </div>

     <div class="mb-3">
        <label for="maxGuests" class="form-label">Maximum Guests</label>
        <input name="listing[maxGuests]" placeholder="How many guests can your property accommodate?" type="number" class="form-control" min="1" value="1" required/>
        <div class="valid-feedback">Looks good</div>
        <div class="invalid-feedback">Please enter the maximum number of guests (minimum 1)</div>
        <small class="form-text text-muted">Enter the total number of guests your property can accommodate at once</small>
     </div>

     <div class="mb-3">
        <label for="ownerUpiId" class="form-label">Your UPI ID (for payment collection)</label>
        <input 
          name="listing[ownerUpiId]" 
          placeholder="e.g., yourname@bankname" 
          type="text" 
          class="form-control required"
          pattern="[a-zA-Z0-9._-]+@[a-zA-Z0-9]+"
        />
        <div class="valid-feedback">UPI ID looks good</div>
        <div class="invalid-feedback">Please enter a valid UPI ID (e.g., yourname@okhdfcbank)</div>
        <small class="form-text text-muted">Your UPI ID will be used for collecting payments from guests. Format: yourname@bankname</small>
     </div>
      
      
      <button class="btn btn-dark add-btn" type="submit">Add</button>
      <br><br><br>
    </form>

    <script src="/js/locationPicker.js"></script>
  </body>
  </div>
</div>