<%-layout("/layouts/boilerplate")%>

<style>
  .success-container {
    background: #f5f7fa;
    min-height: 100vh;
    padding: 40px 0;
    display: flex;
    align-items: center;
  }

  .success-card {
    background: white;
    border-radius: 12px;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.1);
    overflow: hidden;
  }

  .success-header {
    background: linear-gradient(135deg, #10b981 0%, #059669 100%);
    padding: 40px 30px;
    text-align: center;
    color: white;
  }

  .success-icon {
    font-size: 60px;
    margin-bottom: 20px;
    animation: scaleIn 0.6s ease-out;
  }

  @keyframes scaleIn {
    from {
      transform: scale(0.5);
      opacity: 0;
    }
    to {
      transform: scale(1);
      opacity: 1;
    }
  }

  .success-header h1 {
    font-size: 32px;
    font-weight: 700;
    margin: 0;
  }

  .success-header p {
    font-size: 15px;
    margin-top: 8px;
    opacity: 0.95;
  }

  .receipt-section {
    padding: 30px;
  }

  .receipt-title {
    font-size: 18px;
    font-weight: 600;
    color: #1a202c;
    margin-bottom: 20px;
  }

  .receipt-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    margin-bottom: 20px;
  }

  .receipt-item h6 {
    color: #718096;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    margin-bottom: 8px;
    letter-spacing: 0.5px;
  }

  .receipt-item p {
    font-size: 15px;
    font-weight: 500;
    color: #1a202c;
    margin: 0;
  }

  .divider {
    border-top: 1px solid #e5e7eb;
    margin: 20px 0;
  }

  .amount-section {
    background: #f9fafb;
    padding: 20px;
    border-radius: 10px;
    margin: 20px 0;
  }

  .amount-row {
    display: flex;
    justify-content: space-between;
    margin-bottom: 12px;
    font-size: 14px;
  }

  .amount-row:last-child {
    margin-bottom: 0;
    padding-top: 12px;
    border-top: 2px solid #e5e7eb;
    font-size: 18px;
    font-weight: 700;
    color: #059669;
  }

  .tips-box {
    background: #dbeafe;
    border-left: 4px solid #0c63e4;
    padding: 16px;
    border-radius: 8px;
    margin: 20px 0;
    font-size: 13px;
    color: #0c4a6e;
  }

  .tips-box h6 {
    font-weight: 600;
    margin-bottom: 8px;
    color: #0c4a6e;
  }

  .tips-box ul {
    margin: 0;
    padding-left: 20px;
  }

  .tips-box li {
    margin-bottom: 6px;
  }

  .qr-section {
    text-align: center;
    padding: 20px 0;
    border-top: 1px solid #e5e7eb;
    margin-top: 20px;
  }

  .qr-section h6 {
    color: #1a202c;
    font-size: 14px;
    font-weight: 600;
    margin-bottom: 12px;
  }

  .qr-section img {
    max-width: 150px;
    border-radius: 8px;
  }

  .action-buttons {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    padding: 20px 30px;
    background: #f9fafb;
    border-top: 1px solid #e5e7eb;
  }

  .btn-action {
    padding: 12px 20px;
    border-radius: 8px;
    font-weight: 600;
    font-size: 14px;
    text-align: center;
    transition: all 0.2s ease;
    text-decoration: none;
    display: inline-block;
  }

  .btn-primary-action {
    background: #0c63e4;
    color: white;
    border: 1px solid #0c63e4;
  }

  .btn-primary-action:hover {
    background: #0955c7;
    color: white;
  }

  .btn-secondary-action {
    background: white;
    color: #0c63e4;
    border: 1px solid #e5e7eb;
  }

  .btn-secondary-action:hover {
    background: #f9fafb;
  }

  @media (max-width: 768px) {
    .receipt-grid {
      grid-template-columns: 1fr;
    }
    .action-buttons {
      grid-template-columns: 1fr;
    }
  }
</style>

<div class="success-container">
  <div class="container">
    <div class="row">
      <div class="col-md-8 offset-md-2">
      <div class="success-card">
        <div class="success-header">
          <div class="success-icon">
            <i class="fas fa-check-circle"></i>
          </div>
          <h1>Payment Confirmed</h1>
          <p>Your booking is confirmed and payment has been processed</p>
        </div>

        <div class="receipt-section">
          <h3 style="font-size: 16px; font-weight: 600; color: #1a202c; margin-bottom: 20px;">Booking Details</h3>
          <div class="receipt-grid">
            <div class="receipt-item">
              <h6><i class="fas fa-home"></i> Property</h6>
              <p><%= booking.listing.title %></p>
            </div>
            <div class="receipt-item">
              <h6><i class="fas fa-map-marker-alt"></i> Location</h6>
              <p><%= booking.listing.location %></p>
            </div>
            <div class="receipt-item">
              <h6><i class="fas fa-calendar-check"></i> Check-in</h6>
              <p><%= new Date(booking.checkIn).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></p>
            </div>
            <div class="receipt-item">
              <h6><i class="fas fa-calendar-times"></i> Check-out</h6>
              <p><%= new Date(booking.checkOut).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></p>
            </div>
            <div class="receipt-item">
              <h6><i class="fas fa-users"></i> Guests</h6>
              <p><%= booking.guests %> <%= booking.guests === 1 ? 'Guest' : 'Guests' %></p>
            </div>
            <div class="receipt-item">
              <h6><i class="fas fa-credit-card"></i> Payment Method</h6>
              <p>
                <% if (booking.paymentMethod === 'upi') { %>
                  UPI
                <% } else { %>
                  Cash on Arrival
                <% } %>
              </p>
            </div>
          </div>

          <div class="divider"></div>

          <!-- Price Details -->
          <h3 style="font-size: 16px; font-weight: 600; color: #1a202c; margin-bottom: 16px;">Price Summary</h3>
          <div class="amount-section">
            <div class="amount-row">
              <span>₹<%= booking.listing.price %> × <%= Math.ceil((new Date(booking.checkOut) - new Date(booking.checkIn)) / (1000 * 60 * 60 * 24)) %> nights</span>
              <span>₹<%= (booking.listing.price * Math.ceil((new Date(booking.checkOut) - new Date(booking.checkIn)) / (1000 * 60 * 60 * 24))).toLocaleString('en-IN') %></span>
            </div>
            <div class="amount-row">
              <span>Amount Paid</span>
              <span>₹<%= booking.totalPrice.toLocaleString('en-IN') %></span>
            </div>
          </div>

          <!-- Transaction ID -->
          <div style="background: #f9fafb; padding: 14px; border-radius: 8px; margin-bottom: 20px;">
            <h6 style="color: #718096; font-size: 12px; margin-bottom: 6px;">Transaction Reference</h6>
            <p style="font-family: 'Monaco', monospace; font-size: 13px; color: #0c63e4; margin: 0; word-break: break-all;">
              <strong><%= payment.transactionId %></strong>
            </p>
          </div>

          <!-- Important Information -->
          <div class="tips-box">
            <h6><i class="fas fa-info-circle"></i> Important Information</h6>
            <ul>
              <li>Confirmation email sent to your registered email</li>
              <li>Check-in: 3:00 PM | Check-out: 11:00 AM</li>
              <li>Bring your booking confirmation or ID</li>
              <li>For changes, contact the property owner</li>
              <% if (booking.paymentMethod === 'cash') { %>
                <li style="font-weight: 600; color: #ea580c;">Cash payment due at check-in (within 2 hours)</li>
              <% } %>
            </ul>
          </div>

          <!-- QR Code (if UPI payment) -->
          <% if (payment && payment.qrCode) { %>
            <div class="qr-section">
              <h6>Payment Reference QR Code</h6>
              <img src="<%= payment.qrCode %>" alt="UPI QR Code">
              <p style="font-size: 12px; color: #718096; margin-top: 8px;">Keep for your records</p>
            </div>
          <% } %>
        </div>

        <!-- Action Buttons -->
        <div class="action-buttons">
          <a href="/bookings/my-bookings" class="btn-action btn-primary-action">
            <i class="fas fa-calendar-check"></i> My Bookings
          </a>
          <a href="/listings" class="btn-action btn-secondary-action">
            <i class="fas fa-home"></i> Browse Listings
          </a>
        </div>
      </div>
      </div>
    </div>
  </div>
</div>
