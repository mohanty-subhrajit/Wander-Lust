<%-layout("/layouts/boilerplate")%>

<div class="container mt-5 mb-5">
  <div class="row">
    <div class="col-md-8 offset-md-2">
      <div class="card shadow-lg border-success">
        <div class="card-header bg-success text-white text-center">
          <h2 class="mb-0">
            <i class="bi bi-check-circle"></i> Payment Successful
          </h2>
        </div>

        <div class="card-body text-center">
          <!-- Success Icon -->
          <div class="mb-4">
            <i class="bi bi-check-circle-fill text-success" style="font-size: 4rem;"></i>
          </div>

          <h3 class="text-success mb-3">Thank you for your payment!</h3>
          <p class="lead mb-4">Your booking has been confirmed and payment has been processed successfully.</p>

          <!-- Receipt Details -->
          <div class="alert alert-light border border-success mb-4">
            <h5 class="mb-3">Receipt Summary</h5>

            <div class="row text-start">
              <div class="col-md-6 mb-3">
                <h6 class="text-muted">Property</h6>
                <p class="fs-5"><strong><%= booking.listing.title %></strong></p>
              </div>
              <div class="col-md-6 mb-3">
                <h6 class="text-muted">Location</h6>
                <p class="fs-5"><strong><%= booking.listing.location %></strong></p>
              </div>
            </div>

            <hr>

            <div class="row text-start">
              <div class="col-md-6 mb-3">
                <h6 class="text-muted">Check-in Date</h6>
                <p class="fs-5"><strong><%= new Date(booking.checkIn).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></strong></p>
              </div>
              <div class="col-md-6 mb-3">
                <h6 class="text-muted">Check-out Date</h6>
                <p class="fs-5"><strong><%= new Date(booking.checkOut).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></strong></p>
              </div>
            </div>

            <hr>

            <div class="row text-start">
              <div class="col-md-6 mb-3">
                <h6 class="text-muted">Number of Guests</h6>
                <p class="fs-5"><strong><%= booking.guests %></strong></p>
              </div>
              <div class="col-md-6 mb-3">
                <h6 class="text-muted">Payment Method</h6>
                <p class="fs-5">
                  <strong>
                    <% if (booking.paymentMethod === 'upi') { %>
                      UPI
                    <% } else { %>
                      Cash on Arrival
                    <% } %>
                  </strong>
                </p>
              </div>
            </div>

            <hr>

            <div class="row text-start">
              <div class="col-md-6 mb-3">
                <h6 class="text-muted">Total Amount Paid</h6>
                <p class="fs-4 text-success"><strong>₹<%= booking.totalPrice %></strong></p>
              </div>
              <div class="col-md-6 mb-3">
                <h6 class="text-muted">Transaction ID</h6>
                <p class="fs-5 text-monospace"><strong><%= payment.transactionId %></strong></p>
              </div>
            </div>
          </div>

          <!-- Important Notes -->
          <div class="alert alert-info" role="alert">
            <h6 class="mb-2">Important Information</h6>
            <ul class="mb-0 text-start small">
              <li>A confirmation email has been sent to your registered email address</li>
              <li>Check-in time is typically 3 PM. Check-out time is 11 AM</li>
              <li>Please arrive with your booking confirmation ID</li>
              <li>For any changes or cancellations, contact the property owner through the platform</li>
              <% if (booking.paymentMethod === 'cash') { %>
                <li class="text-warning"><strong>Note:</strong> Final payment will be collected in cash at the property</li>
              <% } %>
            </ul>
          </div>

          <!-- QR Code (if UPI payment) -->
          <% if (payment && payment.qrCode) { %>
            <div class="mb-4">
              <h6>UPI Payment QR Code</h6>
              <img src="<%= payment.qrCode %>" alt="UPI QR Code" style="width: 200px; height: 200px;">
              <p class="small text-muted mt-2">Scan for payment reference</p>
            </div>
          <% } %>

          <!-- Action Buttons -->
          <div class="row">
            <div class="col-md-6 mb-2">
              <a href="/bookings/my-bookings" class="btn btn-primary btn-lg w-100">
                <i class="bi bi-calendar-check"></i> View My Bookings
              </a>
            </div>
            <div class="col-md-6 mb-2">
              <a href="/listings" class="btn btn-secondary btn-lg w-100">
                <i class="bi bi-house"></i> Browse Listings
              </a>
            </div>
          </div>
        </div>

        <div class="card-footer text-center text-muted">
          <small>
            Thank you for choosing Wanderlust! 
            <br/>
            We hope you have a wonderful stay.
          </small>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
.text-monospace {
  font-family: 'Courier New', monospace;
}

.card {
  border-radius: 10px;
}

.card-header {
  border-radius: 10px 10px 0 0;
}
</style>
