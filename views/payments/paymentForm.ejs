<%-layout("/layouts/boilerplate")%>

<style>
  .payment-container {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    min-height: 100vh;
    padding: 40px 0;
  }

  .payment-card {
    border: none;
    border-radius: 15px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
    overflow: hidden;
  }

  .payment-header {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    padding: 30px;
    color: white;
    border-radius: 15px 15px 0 0;
  }

  .payment-header h2 {
    margin: 0;
    font-weight: bold;
    font-size: 28px;
  }

  .booking-info-card {
    background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
    border: none;
    border-radius: 15px;
    margin-bottom: 25px;
    padding: 25px;
  }

  .info-row {
    display: flex;
    justify-content: space-between;
    padding: 10px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.3);
  }

  .info-row:last-child {
    border-bottom: none;
  }

  .info-label {
    font-weight: bold;
    color: #333;
  }

  .info-value {
    color: #667eea;
    font-weight: 600;
  }

  .summary-card {
    background: white;
    border: 2px solid #f0f0f0;
    border-radius: 15px;
    margin-bottom: 25px;
    overflow: hidden;
  }

  .summary-header {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    padding: 15px 20px;
    color: white;
    font-weight: bold;
  }

  .summary-row {
    display: flex;
    justify-content: space-between;
    padding: 12px 20px;
    border-bottom: 1px solid #f0f0f0;
  }

  .summary-row:last-child {
    border-bottom: none;
  }

  .total-row {
    background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
    padding: 20px;
    color: white;
    font-size: 24px;
    font-weight: bold;
    margin-top: 20px;
    border-radius: 10px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .payment-method-card {
    border: 2px solid #e0e0e0;
    border-radius: 15px;
    margin-bottom: 15px;
    transition: all 0.3s ease;
  }

  .payment-method-card:hover {
    border-color: #667eea;
    box-shadow: 0 5px 15px rgba(102, 126, 234, 0.2);
  }

  .payment-method-card.active {
    border-color: #667eea;
    background: rgba(102, 126, 234, 0.05);
  }

  .upi-details,
  .cash-details {
    background: #f8f9fa;
    padding: 15px;
    border-radius: 10px;
    margin-left: 30px;
  }

  .btn-proceed {
    background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
    border: none;
    font-weight: bold;
    font-size: 16px;
    padding: 12px;
  }

  .btn-proceed:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 20px rgba(245, 87, 108, 0.4);
  }
</style>

<div class="payment-container">
  <div class="container">
    <div class="row">
      <div class="col-12 col-md-8 offset-md-2 col-lg-8 offset-lg-2">
        <div class="payment-card">
          <div class="payment-header">
            <h2><i class="fas fa-credit-card"></i> Secure Payment</h2>
            <p class="mb-0 mt-2">Complete your booking payment</p>
          </div>

          <div class="card-body p-4">
            <!-- Booking Information -->
            <div class="booking-info-card">
              <h5 style="margin-bottom: 15px; color: #333;"><i class="fas fa-info-circle"></i> Booking Details</h5>
              <div class="info-row">
                <span class="info-label"><i class="fas fa-home"></i> Property:</span>
                <span class="info-value"><%= booking.listing.title %></span>
              </div>
              <div class="info-row">
                <span class="info-label"><i class="fas fa-map-marker-alt"></i> Location:</span>
                <span class="info-value"><%= booking.listing.location %></span>
              </div>
              <div class="info-row">
                <span class="info-label"><i class="fas fa-calendar-check"></i> Check-in:</span>
                <span class="info-value"><%= new Date(booking.checkIn).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></span>
              </div>
              <div class="info-row">
                <span class="info-label"><i class="fas fa-calendar-times"></i> Check-out:</span>
                <span class="info-value"><%= new Date(booking.checkOut).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></span>
              </div>
              <div class="info-row">
                <span class="info-label"><i class="fas fa-users"></i> Guests:</span>
                <span class="info-value"><%= booking.guests %> <%= booking.guests === 1 ? 'Guest' : 'Guests' %></span>
              </div>
            </div>

            <!-- Payment Summary -->
            <div class="summary-card">
              <div class="summary-header">
                <i class="fas fa-receipt"></i> Payment Summary
              </div>
              <div class="summary-row">
                <span>Price per night:</span>
                <strong>₹<%= booking.listing.price %></strong>
              </div>
              <div class="summary-row">
                <span>Number of nights:</span>
                <strong><%= Math.ceil((new Date(booking.checkOut) - new Date(booking.checkIn)) / (1000 * 60 * 60 * 24)) %> nights</strong>
              </div>
              <div class="total-row">
                <span>Total Amount</span>
                <span>₹<%= booking.totalPrice %></span>
              </div>
            </div>

            <!-- Payment Method Selection -->
            <h4 style="margin-bottom: 25px; color: #333;"><i class="fas fa-wallet"></i> Select Payment Method</h4>

            <form action="/payments/booking/<%= booking._id %>/process" method="POST">
              <!-- UPI Payment Option -->
              <div class="payment-method-card" id="upiCard">
                <div class="card-body p-3">
                  <div class="form-check">
                    <input class="form-check-input" type="radio" name="paymentMethod" id="upiRadio" value="upi" checked>
                    <label class="form-check-label" for="upiRadio" style="cursor: pointer; flex: 1;">
                      <strong style="font-size: 18px;"><i class="fas fa-mobile-alt"></i> Pay via UPI</strong>
                      <p class="text-muted mb-0 small">Fast and secure payment through UPI</p>
                    </label>
                  </div>

                  <div class="mt-3 ms-4 upi-details">
                    <% if (listingOwner && listingOwner.upiId) { %>
                      <div style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 15px; border-radius: 10px;">
                        <p class="mb-1"><i class="fas fa-user"></i> <strong>Receiver:</strong> <%= listingOwner.username %></p>
                        <p class="mb-1"><i class="fas fa-qrcode"></i> <strong>UPI ID:</strong> <code style="background: rgba(255,255,255,0.2); padding: 5px 10px; border-radius: 5px;"><%= listingOwner.upiId %></code></p>
                        <p class="mb-0"><i class="fas fa-rupee-sign"></i> <strong>Amount:</strong> <span style="font-size: 18px;">₹<%= booking.totalPrice %></span></p>
                      </div>
                    <% } else { %>
                      <div style="background: #fff3cd; border-left: 4px solid #ff9800; padding: 15px; border-radius: 5px; color: #856404;">
                        <i class="fas fa-exclamation-triangle"></i> Property owner has not set up UPI payment option yet. Please try Cash on Arrival.
                      </div>
                    <% } %>
                  </div>
                </div>
              </div>

              <!-- Cash Payment Option -->
              <div class="payment-method-card" id="cashCard">
                <div class="card-body p-3">
                  <div class="form-check">
                    <input class="form-check-input" type="radio" name="paymentMethod" id="cashRadio" value="cash">
                    <label class="form-check-label" for="cashRadio" style="cursor: pointer; flex: 1;">
                      <strong style="font-size: 18px;"><i class="fas fa-money-bill-wave"></i> Cash on Arrival</strong>
                      <p class="text-muted mb-0 small">Pay cash when you arrive at the property</p>
                    </label>
                  </div>

                  <div class="mt-3 ms-4 cash-details" style="display: none;">
                    <div style="background: #f0f7ff; border-left: 4px solid #2196f3; padding: 15px; border-radius: 5px;">
                      <h6 style="color: #1976d2; margin-bottom: 10px;"><i class="fas fa-info-circle"></i> Cash Payment Details</h6>
                      <ul class="mb-0 small" style="color: #333;">
                        <li><i class="fas fa-check"></i> You will pay <strong>₹<%= booking.totalPrice %></strong> directly to the property owner</li>
                        <li><i class="fas fa-check"></i> Please have exact cash ready</li>
                        <li><i class="fas fa-check"></i> Keep your booking confirmation for reference</li>
                        <li><i class="fas fa-check"></i> Payment must be made within 2 hours of check-in</li>
                      </ul>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Terms & Conditions -->
              <div style="background: #fff3cd; border-left: 4px solid #ff9800; padding: 15px; border-radius: 10px; margin-top: 25px; margin-bottom: 25px;">
                <small style="color: #856404;">
                  <strong><i class="fas fa-shield-alt"></i> Important:</strong> By proceeding with payment, you agree to our terms and conditions. 
                  This is a dummy payment system for demonstration purposes. In real usage, actual payment gateways would be integrated.
                </small>
              </div>

              <!-- Submit Buttons -->
              <div class="row g-3">
                <div class="col-md-6">
                  <button type="submit" class="btn btn-proceed btn-lg w-100">
                    <i class="fas fa-check-circle"></i> Proceed to Payment
                  </button>
                </div>
                <div class="col-md-6">
                  <a href="/bookings/my-bookings" class="btn btn-outline-secondary btn-lg w-100">
                    <i class="fas fa-arrow-left"></i> Back to Bookings
                  </a>
                </div>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  document.getElementById('upiRadio').addEventListener('change', function() {
    document.querySelector('.upi-details').style.display = 'block';
    document.querySelector('.cash-details').style.display = 'none';
  });

  document.getElementById('cashRadio').addEventListener('change', function() {
    document.querySelector('.upi-details').style.display = 'none';
    document.querySelector('.cash-details').style.display = 'block';
  });
</script>
