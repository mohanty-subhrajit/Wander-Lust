<%-layout("/layouts/boilerplate")%>

<div class="container mt-5 mb-5">
  <div class="row">
    <div class="col-md-8 offset-md-2">
      <div class="card shadow-lg">
        <div class="card-header bg-primary text-white">
          <h3 class="mb-0">Payment Details</h3>
        </div>

        <div class="card-body">
          <!-- Booking Information -->
          <div class="alert alert-info" role="alert">
            <h5>Booking Information</h5>
            <table class="table table-sm mb-0">
              <tr>
                <td><strong>Property:</strong></td>
                <td><%= booking.listing.title %></td>
              </tr>
              <tr>
                <td><strong>Location:</strong></td>
                <td><%= booking.listing.location %></td>
              </tr>
              <tr>
                <td><strong>Check-in:</strong></td>
                <td><%= new Date(booking.checkIn).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></td>
              </tr>
              <tr>
                <td><strong>Check-out:</strong></td>
                <td><%= new Date(booking.checkOut).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></td>
              </tr>
              <tr>
                <td><strong>Number of Guests:</strong></td>
                <td><%= booking.guests %></td>
              </tr>
            </table>
          </div>

          <!-- Payment Summary -->
          <div class="card mb-4">
            <div class="card-header bg-light">
              <h5 class="mb-0">Payment Summary</h5>
            </div>
            <div class="card-body">
              <div class="row mb-2">
                <div class="col-6">
                  <span>Price per night:</span>
                </div>
                <div class="col-6 text-end">
                  <strong>₹<%= booking.listing.price %></strong>
                </div>
              </div>
              <div class="row mb-2">
                <div class="col-6">
                  <span>Number of nights:</span>
                </div>
                <div class="col-6 text-end">
                  <strong><%= Math.ceil((new Date(booking.checkOut) - new Date(booking.checkIn)) / (1000 * 60 * 60 * 24)) %></strong>
                </div>
              </div>
              <hr>
              <div class="row">
                <div class="col-6">
                  <h5>Total Amount:</h5>
                </div>
                <div class="col-6 text-end">
                  <h5 class="text-success"><strong>₹<%= booking.totalPrice %></strong></h5>
                </div>
              </div>
            </div>
          </div>

          <!-- Payment Method Selection -->
          <h4 class="mb-3">Select Payment Method</h4>

          <form action="/payments/booking/<%= booking._id %>/process" method="POST">
            <!-- UPI Payment Option -->
            <div class="card mb-3 border-primary">
              <div class="card-body">
                <div class="form-check">
                  <input class="form-check-input" type="radio" name="paymentMethod" id="upiRadio" value="upi" checked>
                  <label class="form-check-label" for="upiRadio">
                    <strong>Pay via UPI</strong>
                    <p class="text-muted mb-0 small">Fast and secure payment through UPI</p>
                  </label>
                </div>

                <div class="mt-3 ms-4 upi-details">
                  <div class="alert alert-light border-primary">
                    <h6 class="mb-2">UPI Payment Details</h6>
                    <% if (listingOwner && listingOwner.upiId) { %>
                      <p class="mb-1"><strong>Receiver:</strong> <%= listingOwner.username %></p>
                      <p class="mb-1"><strong>UPI ID:</strong> <code><%= listingOwner.upiId %></code></p>
                      <p class="mb-0"><strong>Amount:</strong> <span class="text-success fs-5">₹<%= booking.totalPrice %></span></p>
                    <% } else { %>
                      <div class="alert alert-warning mb-0">
                        Property owner has not set up UPI payment option yet. Please try Cash on Arrival.
                      </div>
                    <% } %>
                  </div>
                </div>
              </div>
            </div>

            <!-- Cash Payment Option -->
            <div class="card mb-3 border-secondary">
              <div class="card-body">
                <div class="form-check">
                  <input class="form-check-input" type="radio" name="paymentMethod" id="cashRadio" value="cash">
                  <label class="form-check-label" for="cashRadio">
                    <strong>Cash on Arrival</strong>
                    <p class="text-muted mb-0 small">Pay cash when you arrive at the property</p>
                  </label>
                </div>

                <div class="mt-3 ms-4 cash-details" style="display: none;">
                  <div class="alert alert-light border-secondary">
                    <h6 class="mb-2">Cash Payment Details</h6>
                    <ul class="mb-0 small">
                      <li>You will pay <strong>₹<%= booking.totalPrice %></strong> directly to the property owner</li>
                      <li>Please have exact cash ready</li>
                      <li>Keep your booking confirmation for reference</li>
                      <li>Payment must be made within 2 hours of check-in</li>
                    </ul>
                  </div>
                </div>
              </div>
            </div>

            <!-- Terms & Conditions -->
            <div class="alert alert-warning" role="alert">
              <small>
                <strong>Important:</strong> By proceeding with payment, you agree to our terms and conditions. 
                This is a dummy payment system for demonstration purposes. In real usage, actual payment gateways would be integrated.
              </small>
            </div>

            <!-- Submit Buttons -->
            <div class="row">
              <div class="col-md-6">
                <button type="submit" class="btn btn-success btn-lg w-100">
                  <i class="bi bi-check-circle"></i> Proceed to Payment
                </button>
              </div>
              <div class="col-md-6">
                <a href="/bookings/my-bookings" class="btn btn-secondary btn-lg w-100">
                  <i class="bi bi-arrow-left"></i> Back to Bookings
                </a>
              </div>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  document.getElementById('upiRadio').addEventListener('change', function() {
    document.querySelector('.upi-details').style.display = 'block';
    document.querySelector('.cash-details').style.display = 'none';
  });

  document.getElementById('cashRadio').addEventListener('change', function() {
    document.querySelector('.upi-details').style.display = 'none';
    document.querySelector('.cash-details').style.display = 'block';
  });
</script>
