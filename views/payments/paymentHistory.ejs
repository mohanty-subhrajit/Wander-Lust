<%-layout("/layouts/boilerplate")%>

<div class="container mt-5 mb-5">
  <div class="row">
    <div class="col-md-10 offset-md-1">
      <h1 class="mb-4">Payment History</h1>

      <% if (payments.length === 0) { %>
        <div class="alert alert-info text-center" role="alert">
          <h5>No Payments Yet</h5>
          <p>You haven't made any payments yet. Start booking and complete your payments to see them here.</p>
          <a href="/bookings/my-bookings" class="btn btn-primary">View My Bookings</a>
        </div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table table-hover table-striped">
            <thead class="table-dark">
              <tr>
                <th>Transaction ID</th>
                <th>Property</th>
                <th>Amount</th>
                <th>Payment Method</th>
                <th>Status</th>
                <th>Date</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody>
              <% payments.forEach(payment => { %>
                <tr>
                  <td>
                    <code><small><%= payment.transactionId %></small></code>
                  </td>
                  <td>
                    <% if (payment.booking) { %>
                      <strong><a href="/listings/<%= payment.booking.listing %>"><%= payment.booking.listing.title || 'N/A' %></a></strong>
                    <% } else { %>
                      <span class="text-muted">Booking Deleted</span>
                    <% } %>
                  </td>
                  <td>
                    <strong class="text-success">₹<%= payment.amount %></strong>
                  </td>
                  <td>
                    <% if (payment.paymentMethod === 'upi') { %>
                      <span class="badge bg-primary">UPI</span>
                    <% } else if (payment.paymentMethod === 'cash') { %>
                      <span class="badge bg-warning text-dark">Cash</span>
                    <% } %>
                  </td>
                  <td>
                    <% if (payment.status === 'completed') { %>
                      <span class="badge bg-success">Completed</span>
                    <% } else if (payment.status === 'pending') { %>
                      <span class="badge bg-warning text-dark">Pending</span>
                    <% } else { %>
                      <span class="badge bg-danger">Failed</span>
                    <% } %>
                  </td>
                  <td>
                    <small><%= new Date(payment.createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %></small>
                  </td>
                  <td>
                    <a href="/payments/success/<%= payment.booking._id %>" class="btn btn-sm btn-info">
                      View
                    </a>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>

        <!-- Summary Card -->
        <div class="card mt-4">
          <div class="card-header bg-light">
            <h5 class="mb-0">Payment Summary</h5>
          </div>
          <div class="card-body">
            <div class="row">
              <div class="col-md-4">
                <h6 class="text-muted">Total Payments</h6>
                <h3 class="text-primary"><%= payments.length %></h3>
              </div>
              <div class="col-md-4">
                <h6 class="text-muted">Amount Spent</h6>
                <h3 class="text-success">
                  ₹<%= payments.reduce((sum, p) => sum + p.amount, 0) %>
                </h3>
              </div>
              <div class="col-md-4">
                <h6 class="text-muted">Completed Payments</h6>
                <h3 class="text-success"><%= payments.filter(p => p.status === 'completed').length %></h3>
              </div>
            </div>
          </div>
        </div>
      <% } %>

      <!-- Back Button -->
      <div class="mt-4">
        <a href="/bookings/my-bookings" class="btn btn-secondary">
          <i class="bi bi-arrow-left"></i> Back to My Bookings
        </a>
      </div>
    </div>
  </div>
</div>
