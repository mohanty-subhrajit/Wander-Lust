<%-layout("/layouts/boilerplate")%>

<style>
  .history-container {
    background: #f5f7fa;
    min-height: 100vh;
    padding: 30px 0;
  }

  .history-header {
    background: white;
    padding: 30px;
    border-radius: 12px;
    margin-bottom: 24px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  }

  .history-header h1 {
    font-size: 28px;
    font-weight: 600;
    color: #1a202c;
    margin: 0;
  }

  .history-header p {
    color: #718096;
    margin-top: 8px;
    font-size: 14px;
  }

  .payment-table {
    background: white;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  }

  .table {
    margin-bottom: 0;
    font-size: 14px;
  }

  .table thead {
    background: #f9fafb;
    border-bottom: 2px solid #e5e7eb;
  }

  .table thead th {
    color: #4b5563;
    font-weight: 600;
    padding: 16px 20px;
    border: none;
    letter-spacing: 0.5px;
  }

  .table tbody tr {
    transition: all 0.2s ease;
    border-bottom: 1px solid #e5e7eb;
  }

  .table tbody tr:hover {
    background: #f9fafb;
  }

  .table tbody tr:last-child {
    border-bottom: none;
  }

  .table tbody td {
    padding: 16px 20px;
    vertical-align: middle;
    color: #1a202c;
  }

  .transaction-id {
    background: #f3f4f6;
    padding: 6px 12px;
    border-radius: 6px;
    font-family: 'Monaco', 'Menlo', monospace;
    font-size: 12px;
    color: #0c63e4;
    font-weight: 500;
  }

  .amount {
    font-weight: 600;
    color: #059669;
    font-size: 15px;
  }

  .badge {
    padding: 6px 12px;
    font-weight: 500;
    border-radius: 6px;
    font-size: 12px;
    letter-spacing: 0.3px;
  }

  .badge.bg-upi {
    background: #dbeafe;
    color: #0c4a6e;
  }

  .badge.bg-cash {
    background: #dcfce7;
    color: #15803d;
  }

  .badge.bg-completed {
    background: #dcfce7;
    color: #15803d;
  }

  .badge.bg-pending {
    background: #fef3c7;
    color: #92400e;
  }

  .badge.bg-failed {
    background: #fee2e2;
    color: #7f1d1d;
  }

  .stat-card {
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 10px;
    padding: 20px;
    margin-bottom: 16px;
    text-align: center;
  }

  .stat-card h6 {
    color: #718096;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    margin-bottom: 8px;
    letter-spacing: 0.5px;
  }

  .stat-card h3 {
    color: #1a202c;
    font-size: 24px;
    font-weight: 700;
    margin: 0;
  }

  .stat-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 16px;
    margin-top: 24px;
  }

  .empty-state {
    text-align: center;
    padding: 60px 30px;
    background: white;
    border-radius: 12px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  }

  .empty-state i {
    font-size: 48px;
    color: #cbd5e0;
    margin-bottom: 16px;
  }

  .btn-back {
    background: white;
    color: #0c63e4;
    border: 1px solid #e5e7eb;
    font-weight: 500;
    padding: 10px 16px;
  }

  .btn-back:hover {
    background: #f9fafb;
    color: #0955c7;
  }
</style>

<div class="history-container">
  <div class="container">
    <div class="history-header">
      <h1><i class="fas fa-receipt"></i> Payment History</h1>
      <p>Track all your bookings and payments</p>
    </div>

    <% if (payments.length === 0) { %>
      <div class="empty-state">
        <i class="fas fa-inbox"></i>
        <h5>No payments yet</h5>
        <p style="color: #718096; margin-bottom: 20px;">You haven't made any payments. Book a property and complete the payment to see it here.</p>
        <a href="/bookings/my-bookings" class="btn btn-primary">
          <i class="fas fa-calendar"></i> View My Bookings
        </a>
      </div>
    <% } else { %>
      <!-- Summary Stats -->
      <div class="stat-row">
        <div class="stat-card">
          <h6>Total Transactions</h6>
          <h3><%= payments.length %></h3>
        </div>
        <div class="stat-card">
          <h6>Amount Spent</h6>
          <h3 style="color: #059669;">₹<%= payments.reduce((sum, p) => sum + p.amount, 0).toLocaleString('en-IN') %></h3>
        </div>
        <div class="stat-card">
          <h6>Completed</h6>
          <h3 style="color: #0c63e4;"><%= payments.filter(p => p.status === 'completed').length %></h3>
        </div>
      </div>

      <!-- Payments Table -->
      <div class="payment-table">
        <div class="table-responsive">
          <table class="table">
            <thead>
              <tr>
                <th>Transaction ID</th>
                <th>Property</th>
                <th>Amount</th>
                <th>Method</th>
                <th>Status</th>
                <th>Date</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody>
              <% payments.forEach(payment => { %>
                <tr>
                  <td><span class="transaction-id"><%= payment.transactionId.substring(0, 12) %>...</span></td>
                  <td>
                    <% if (payment.booking && payment.booking.listing) { %>
                      <a href="/listings/<%= payment.booking.listing._id %>" style="color: #0c63e4; text-decoration: none;">
                        <strong><%= payment.booking.listing.title %></strong>
                      </a>
                    <% } else { %>
                      <span style="color: #cbd5e0;">Listing removed</span>
                    <% } %>
                  </td>
                  <td><span class="amount">₹<%= payment.amount.toLocaleString('en-IN') %></span></td>
                  <td>
                    <% if (payment.paymentMethod === 'upi') { %>
                      <span class="badge bg-upi">UPI</span>
                    <% } else { %>
                      <span class="badge bg-cash">Cash</span>
                    <% } %>
                  </td>
                  <td>
                    <% if (payment.status === 'completed') { %>
                      <span class="badge bg-completed"><i class="fas fa-check"></i> Completed</span>
                    <% } else if (payment.status === 'pending') { %>
                      <span class="badge bg-pending"><i class="fas fa-clock"></i> Pending</span>
                    <% } else { %>
                      <span class="badge bg-failed"><i class="fas fa-times"></i> Failed</span>
                    <% } %>
                  </td>
                  <td><small style="color: #718096;"><%= new Date(payment.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: '2-digit' }) %></small></td>
                  <td>
                    <a href="/payments/success/<%= payment.booking._id %>" class="btn btn-sm btn-back">
                      View
                    </a>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>
    <% } %>

    <!-- Back Button -->
    <div style="margin-top: 24px;">
      <a href="/bookings/my-bookings" class="btn btn-back">
        <i class="fas fa-arrow-left"></i> Back to Bookings
      </a>
    </div>
  </div>
</div>
