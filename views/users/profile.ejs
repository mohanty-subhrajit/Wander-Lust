<%-layout("/layouts/boilerplate")%>

<style>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
    min-height: 100vh;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
  }

  .profile-wrapper {
    min-height: 100vh;
    padding: 40px 20px;
    background: linear-gradient(180deg, #f8f9fa 0%, #ffffff 100%);
  }

  .profile-container {
    max-width: 900px;
    margin: 0 auto;
  }

  /* Header Section */
  .profile-header {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 40px;
    align-items: center;
    margin-bottom: 50px;
    padding: 40px;
    background: white;
    border-radius: 20px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
  }

  .profile-photo-container {
    display: flex;
    justify-content: center;
  }

  .profile-photo {
    width: 200px;
    height: 200px;
    border-radius: 50%;
    object-fit: cover;
    border: 8px solid #f0f0f0;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
    transition: transform 0.3s ease;
  }

  .profile-photo:hover {
    transform: scale(1.05);
  }

  .profile-intro h2 {
    font-size: 32px;
    color: #222;
    margin-bottom: 10px;
    font-weight: 600;
  }

  .profile-intro p {
    color: #666;
    font-size: 16px;
    margin-bottom: 20px;
  }

  .status-badge {
    display: inline-block;
    padding: 8px 16px;
    background: #f0f0f0;
    color: #333;
    border-radius: 20px;
    font-size: 14px;
    font-weight: 600;
    margin: 10px 10px 10px 0;
  }

  .status-badge.admin {
    background: #fff3cd;
    color: #856404;
    border-left: 3px solid #ffc107;
  }

  .status-badge.user {
    background: #d4edda;
    color: #155724;
    border-left: 3px solid #28a745;
  }

  /* Info Sections */
  .info-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 20px;
    margin-bottom: 30px;
  }

  .info-card {
    background: white;
    padding: 30px;
    border-radius: 16px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
    transition: all 0.3s ease;
  }

  .info-card:hover {
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
    transform: translateY(-2px);
  }

  .info-card-header {
    display: flex;
    align-items: center;
    margin-bottom: 15px;
  }

  .info-card-icon {
    width: 40px;
    height: 40px;
    background: #f0f0f0;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-right: 15px;
    color: #666;
    font-size: 18px;
  }

  .info-card-title {
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: #999;
    font-weight: 600;
  }

  .info-card-value {
    font-size: 18px;
    color: #222;
    font-weight: 600;
    word-break: break-all;
    margin-top: 12px;
  }

  .info-card-empty {
    color: #999;
    font-style: italic;
    font-weight: 400;
  }

  /* Bio & Address - Full Width */
  .full-width-card {
    grid-column: 1 / -1;
  }

  .bio-content {
    line-height: 1.6;
    color: #555;
    font-size: 16px;
  }

  /* Member Since */
  .member-info {
    background: white;
    padding: 20px 30px;
    border-radius: 16px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
    display: flex;
    align-items: center;
    gap: 15px;
    margin-bottom: 30px;
  }

  .member-icon {
    width: 50px;
    height: 50px;
    background: #f0f0f0;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #666;
    font-size: 24px;
  }

  .member-text h4 {
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: #999;
    margin: 0;
    font-weight: 600;
  }

  .member-text p {
    font-size: 18px;
    color: #222;
    margin: 5px 0 0 0;
    font-weight: 600;
  }

  /* Action Buttons */
  .button-group {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 15px;
    margin-top: 30px;
  }

  @media (max-width: 640px) {
    .button-group {
      grid-template-columns: 1fr;
    }

    .profile-header {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .profile-intro h2 {
      font-size: 24px;
    }

    .info-grid {
      grid-template-columns: 1fr;
    }
  }

  .btn-primary-custom {
    padding: 14px 28px;
    background: #2563eb;
    color: white;
    border: none;
    border-radius: 12px;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    text-decoration: none;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
  }

  .btn-primary-custom:hover {
    background: #1d4ed8;
    transform: translateY(-2px);
    box-shadow: 0 8px 16px rgba(37, 99, 235, 0.3);
    color: white;
  }

  .btn-secondary-custom {
    padding: 14px 28px;
    background: #f0f0f0;
    color: #222;
    border: 2px solid #e0e0e0;
    border-radius: 12px;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    text-decoration: none;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
  }

  .btn-secondary-custom:hover {
    background: #ffffff;
    border-color: #d0d0d0;
    color: #222;
    transform: translateY(-2px);
  }

  /* Responsive adjustments */
  @media (max-width: 768px) {
    .profile-wrapper {
      padding: 20px 15px;
    }

    .profile-header {
      padding: 30px 20px;
    }

    .profile-intro h2 {
      font-size: 26px;
    }

    .info-card {
      padding: 20px;
    }
  }
</style>

<div class="profile-wrapper">
  <div class="profile-container">
    
    <!-- Header Section -->
    <div class="profile-header">
      <div class="profile-photo-container">
        <% if (user.profilePhoto && user.profilePhoto.url) { %>
          <img src="<%= user.profilePhoto.url %>" alt="<%= user.username %>" class="profile-photo">
        <% } else { %>
          <img src="https://via.placeholder.com/200" alt="<%= user.username %>" class="profile-photo">
        <% } %>
      </div>
      
      <div class="profile-intro">
        <h2><%= user.username %></h2>
        <p>Member since <%= new Date(user.createdAt).toLocaleDateString('en-US', { month: 'long', year: 'numeric' }) %></p>
        
        <div>
          <% if (user.isAdmin) { %>
            <span class="status-badge admin">
              <i class="fas fa-crown"></i> Admin Account
            </span>
          <% } else { %>
            <span class="status-badge user">
              <i class="fas fa-user-check"></i> User Account
            </span>
          <% } %>
        </div>
      </div>
    </div>

    <!-- Info Cards Grid -->
    <div class="info-grid">
      <!-- Email -->
      <div class="info-card">
        <div class="info-card-header">
          <div class="info-card-icon">📧</div>
          <div class="info-card-title">Email Address</div>
        </div>
        <div class="info-card-value"><%= user.email %></div>
      </div>

      <!-- Phone -->
      <div class="info-card">
        <div class="info-card-header">
          <div class="info-card-icon">📱</div>
          <div class="info-card-title">Phone Number</div>
        </div>
        <% if (user.mobileNumber) { %>
          <div class="info-card-value"><%= user.mobileNumber %></div>
        <% } else { %>
          <div class="info-card-value info-card-empty">Not provided</div>
        <% } %>
      </div>

      <!-- UPI -->
      <div class="info-card">
        <div class="info-card-header">
          <div class="info-card-icon">💳</div>
          <div class="info-card-title">UPI ID</div>
        </div>
        <% if (user.upiId) { %>
          <div class="info-card-value"><%= user.upiId %></div>
        <% } else { %>
          <div class="info-card-value info-card-empty">Not provided</div>
        <% } %>
      </div>

      <!-- Bio -->
      <div class="info-card full-width-card">
        <div class="info-card-header">
          <div class="info-card-icon">✍️</div>
          <div class="info-card-title">Bio</div>
        </div>
        <% if (user.bio) { %>
          <div class="bio-content"><%= user.bio %></div>
        <% } else { %>
          <div class="info-card-value info-card-empty">No bio added yet</div>
        <% } %>
      </div>

      <!-- Address -->
      <div class="info-card full-width-card">
        <div class="info-card-header">
          <div class="info-card-icon">📍</div>
          <div class="info-card-title">Address</div>
        </div>
        <% if (user.address) { %>
          <div class="bio-content"><%= user.address %></div>
        <% } else { %>
          <div class="info-card-value info-card-empty">No address added yet</div>
        <% } %>
      </div>
    </div>

    <!-- Member Info -->
    <div class="member-info">
      <div class="member-icon">🔒</div>
      <div class="member-text">
        <h4>Account Security</h4>
        <p>Your profile is secure and private</p>
      </div>
    </div>

    <!-- Action Buttons -->
    <div class="button-group">
      <a href="/users/profile/edit" class="btn-primary-custom">
        <i class="fas fa-edit"></i> Edit Profile
      </a>
      <a href="/listings" class="btn-secondary-custom">
        <i class="fas fa-arrow-left"></i> Back to Listings
      </a>
    </div>

  </div>
</div>
