<%-layout("/layouts/boilerplate")%>

<div class="container mt-5 mb-5">
  <div class="row">
    <div class="col-md-6 offset-md-3">
      <div class="card shadow">
        <!-- Profile Photo -->
        <div class="card-img-top text-center py-4" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
          <% if (user.profilePhoto && user.profilePhoto.url) { %>
            <img src="<%= user.profilePhoto.url %>" alt="<%= user.username %>" class="rounded-circle" style="width: 150px; height: 150px; object-fit: cover; border: 5px solid white;">
          <% } else { %>
            <img src="https://via.placeholder.com/150" alt="<%= user.username %>" class="rounded-circle" style="width: 150px; height: 150px; border: 5px solid white;">
          <% } %>
        </div>

        <div class="card-body text-center">
          <h2 class="card-title"><%= user.username %></h2>
          <p class="text-muted mb-3"><%= user.email %></p>

          <!-- User Info -->
          <div class="row mb-4">
            <div class="col-6">
              <h6 class="text-muted">Mobile</h6>
              <p class="card-text">
                <% if (user.mobileNumber) { %>
                  <strong><%= user.mobileNumber.replace(/(\d{2})(\d{4})(\d{4})/, '$1****$3') %></strong>
                <% } else { %>
                  <span class="text-secondary">Not provided</span>
                <% } %>
              </p>
            </div>
            <div class="col-6">
              <h6 class="text-muted">Member Since</h6>
              <p class="card-text"><strong><%= new Date(user.createdAt).getFullYear() %></strong></p>
            </div>
          </div>

          <% if (user.bio) { %>
            <div class="mb-4">
              <h6 class="text-muted">About</h6>
              <p class="card-text text-muted"><em>"<%= user.bio %>"</em></p>
            </div>
          <% } %>

          <% if (user.address) { %>
            <div class="mb-4">
              <h6 class="text-muted">Location</h6>
              <p class="card-text"><i class="bi bi-geo-alt text-danger"></i> <%= user.address %></p>
            </div>
          <% } %>

          <!-- Account Badge -->
          <div class="mb-3">
            <% if (user.isAdmin) { %>
              <span class="badge bg-danger">Administrator</span>
            <% } else { %>
              <span class="badge bg-success">Verified Member</span>
            <% } %>
          </div>

          <!-- Back Button -->
          <a href="/listings" class="btn btn-primary btn-sm">Back to Listings</a>
        </div>
      </div>
    </div>
  </div>
</div>
