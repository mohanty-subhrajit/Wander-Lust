<%- layout("/layouts/boilerplate") %>

<div class="container-fluid mt-4">
  <!-- Admin Navigation Tabs -->
  <div class="mb-4">
    <ul class="nav nav-tabs" role="tablist">
      <li class="nav-item">
        <a class="nav-link" href="/listings/admin/all-listings">
          <i class="fa-solid fa-building"></i> Listings
        </a>
      </li>
      <li class="nav-item">
        <a class="nav-link active" href="/bookings/admin/bookings">
          <i class="fa-solid fa-calendar-check"></i> Dashboard
        </a>
      </li>
      <li class="nav-item">
        <a class="nav-link" href="/payments/admin/payments">
          <i class="fa-solid fa-credit-card"></i> Payments
        </a>
      </li>
      <li class="nav-item">
        <a class="nav-link" href="/users/admin/users">
          <i class="fa-solid fa-users"></i> Users
        </a>
      </li>
    </ul>
  </div>

  <h2><i class="fa-solid fa-calendar-check"></i> Admin Dashboard</h2>
  <p class="text-muted">Platform overview and statistics</p>
  <hr>
  <br>

  <!-- Stats Cards -->
  <div class="row">
    <div class="col-md-4 mb-4">
      <div class="card">
        <div class="card-body">
          <h5 class="card-title">📊 Total Bookings</h5>
          <h3 class="text-primary"><%= totalBookings || 0 %></h3>
        </div>
      </div>
    </div>
    <div class="col-md-4 mb-4">
      <div class="card">
        <div class="card-body">
          <h5 class="card-title">✅ Valid Bookings</h5>
          <h3 class="text-success"><%= bookings ? bookings.length : 0 %></h3>
        </div>
      </div>
    </div>
    <div class="col-md-4 mb-4">
      <div class="card">
        <div class="card-body">
          <h5 class="card-title">⚠️  System Status</h5>
          <h3 class="text-success">🟢 Healthy</h3>
        </div>
      </div>
    </div>
  </div>

  <hr>

  <!-- Information Box -->
  <div class="alert alert-info" role="alert">
    <h5><i class="fa-solid fa-info-circle"></i> Booking Management</h5>
    <p>Booking confirmations and management are delegated to <strong>property owners</strong> in their <strong>"Manage Bookings"</strong> section. This ensures direct communication between owners and guests.</p>
    <hr>
    <h6>📍 How it works:</h6>
    <ul>
      <li>✓ Owners view pending bookings for their properties</li>
      <li>✓ Owners confirm or reject bookings directly</li>
      <li>✓ Confirmation emails are sent automatically to guests</li>
      <li>✓ Owners can chat with guests in the<strong>"Confirmed"</strong> tab</li>
      <li>✓ Payment receipts are sent automatically upon payment completion</li>
    </ul>
    <hr>
    <p class="mb-0">
      <strong>Menu Link:</strong> Owners access this from <strong>"Explore" → "My Bookings"</strong> or <strong>"My Profile"</strong>
    </p>
  </div>

  <hr>

  <!-- Summary Section -->
  <div class="card">
    <div class="card-header bg-light">
      <h5 class="mb-0"><i class="fa-solid fa-list"></i> System Summary</h5>
    </div>
    <div class="card-body">
      <% if(totalBookings === 0) { %>
        <div class="text-center text-muted">
          <p>No bookings in the system yet. When users create bookings, they will appear here.</p>
        </div>
      <% } else { %>
        <div class="row">
          <div class="col-md-6">
            <h6>📈 Statistics</h6>
            <ul>
              <li>Total Bookings: <strong><%= totalBookings %></strong></li>
              <li>Valid Bookings: <strong><%= bookings.length %></strong></li>
              <li>Invalid/Orphaned: <strong><%= invalidCount || 0 %></strong></li>
              <li>Health Check: <strong class="text-success">✓ Pass</strong></li>
            </ul>
          </div>
          <div class="col-md-6">
            <h6>⚙️ Actions</h6>
            <p class="text-muted">All booking-related actions (confirm, reject, chat, payment) are managed by property owners in their respective booking management interfaces.</p>
            <a href="/listings/admin/all-listings" class="btn btn-sm btn-outline-primary">
              <i class="fa-solid fa-building"></i> Manage Listings
            </a>
            <a href="/payments/admin/payments" class="btn btn-sm btn-outline-primary">
              <i class="fa-solid fa-credit-card"></i> View Payments
            </a>
          </div>
        </div>
      <% } %>
    </div>
  </div>

</div>
