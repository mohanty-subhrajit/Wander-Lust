<%- layout("/layouts/boilerplate") %>

<div class="container-fluid mt-4">
  <!-- Admin Navigation Tabs -->
  <div class="mb-4">
    <ul class="nav nav-tabs" role="tablist">
      <li class="nav-item">
        <a class="nav-link" href="/listings/admin/all-listings">
          <i class="fa-solid fa-building"></i> Listings
        </a>
      </li>
      <li class="nav-item">
        <a class="nav-link active" href="/bookings/admin/bookings">
          <i class="fa-solid fa-calendar-check"></i> Bookings
        </a>
      </li>
      <li class="nav-item">
        <a class="nav-link" href="/payments/admin/payments">
          <i class="fa-solid fa-credit-card"></i> Payments
        </a>
      </li>
      <li class="nav-item">
        <a class="nav-link" href="/users/admin/users">
          <i class="fa-solid fa-users"></i> Users
        </a>
      </li>
    </ul>
  </div>

  <h2><i class="fa-solid fa-calendar-check"></i> Manage All Bookings</h2>
  <p class="text-muted">View and manage all booking requests</p>
  <hr>
  <br>

  <% if(bookings.length === 0) { %>
    <div class="alert alert-info">
      <i class="fa-solid fa-inbox"></i> No bookings yet.
      <% if(debugInfo) { %>
        <hr>
        <small>
          <strong>Debug Info:</strong><br>
          Total in DB: <%= debugInfo.totalInDB %><br>
          After populate: <%= debugInfo.afterPopulate %><br>
          Valid: <%= debugInfo.validBookings %><br>
          Invalid: <%= debugInfo.invalidBookings %>
          <% if(debugInfo.invalidBookings.length > 0) { %>
            <div class="mt-2">
              <strong>Invalid Bookings:</strong>
              <% debugInfo.invalidBookings.forEach(b => { %>
                <div>- <%= b.id %>: <%= b.reason %></div>
              <% }) %>
            </div>
          <% } %>
        </small>
      <% } %>
    </div>
  <% } else { %>
    <!-- Desktop Table View -->
    <div class="d-none d-lg-block">
      <div class="table-responsive">
        <table class="table table-striped table-hover">
          <thead class="table-dark">
            <tr>
              <th>Customer</th>
              <th>Listing</th>
              <th>Check-in</th>
              <th>Check-out</th>
              <th>Guests</th>
              <th>Total Price</th>
              <th>Status</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% for(let booking of bookings) { %>
              <tr>
                <td>
                  <strong><%= booking.customer.username %></strong><br>
                  <small><%= booking.customer.email %></small>
                </td>
                <td>
                  <a href="/listings/<%= booking.listing._id %>">
                    <%= booking.listing.title %>
                  </a><br>
                  <small><%= booking.listing.location %></small>
                </td>
                <td><%= new Date(booking.checkIn).toLocaleDateString() %></td>
                <td><%= new Date(booking.checkOut).toLocaleDateString() %></td>
                <td><%= booking.guests %></td>
                <td>₹<%= booking.totalPrice.toLocaleString("en-IN") %></td>
                <td>
                  <% if(booking.status === 'pending') { %>
                    <span class="badge bg-warning text-dark">Pending</span>
                  <% } else if(booking.status === 'confirmed') { %>
                    <span class="badge bg-success">Confirmed</span>
                  <% } else { %>
                    <span class="badge bg-danger">Rejected</span>
                  <% } %>
                </td>
                <td>
                  <% if(booking.status === 'pending') { %>
                    <form action="/bookings/<%= booking._id %>/confirm" method="POST" style="display: inline;" onsubmit="return confirm('Confirm this booking?')">
                      <button class="btn btn-sm btn-success" title="Confirm Booking">
                        <i class="fa-solid fa-check"></i> Confirm
                      </button>
                    </form>
                    <form action="/bookings/<%= booking._id %>/reject" method="POST" style="display: inline;" onsubmit="return confirm('Reject this booking?')">
                      <button class="btn btn-sm btn-danger" title="Reject Booking">
                        <i class="fa-solid fa-times"></i> Reject
                      </button>
                    </form>
                  <% } else if(booking.status === 'confirmed') { %>
                    <a href="/chat/booking/<%= booking._id %>" class="btn btn-sm btn-primary" title="Chat with Customer">
                      <i class="fa-solid fa-comments"></i> Chat
                    </a>
                  <% } else { %>
                    <span class="text-muted">-</span>
                  <% } %>
                  <!-- Delete button -->
                  <form action="/bookings/<%= booking._id %>/admin-delete?_method=DELETE" method="POST" style="display: inline;" onsubmit="return confirm('Delete this booking?')">
                    <button class="btn btn-sm btn-outline-danger" title="Delete Booking">
                      <i class="fa-solid fa-trash"></i>
                    </button>
                  </form>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Mobile Card View -->
    <div class="d-lg-none">
      <% for(let booking of bookings) { %>
        <div class="card mb-3">
          <div class="card-body">
            <h5 class="card-title"><%= booking.listing.title %></h5>
            <h6 class="card-subtitle mb-2 text-muted">
              <i class="fa-solid fa-user"></i> <%= booking.customer.username %>
            </h6>
            <p class="card-text">
              <strong>Email:</strong> <%= booking.customer.email %><br>
              <strong>Location:</strong> <%= booking.listing.location %><br>
              <strong>Check-in:</strong> <%= new Date(booking.checkIn).toLocaleDateString() %><br>
              <strong>Check-out:</strong> <%= new Date(booking.checkOut).toLocaleDateString() %><br>
              <strong>Guests:</strong> <%= booking.guests %><br>
              <strong>Total:</strong> ₹<%= booking.totalPrice.toLocaleString("en-IN") %>
            </p>
            <p>
              <% if(booking.status === 'pending') { %>
                <span class="badge bg-warning text-dark">Pending</span>
              <% } else if(booking.status === 'confirmed') { %>
                <span class="badge bg-success">Confirmed</span>
              <% } else { %>
                <span class="badge bg-danger">Rejected</span>
              <% } %>
            </p>
            <% if(booking.status === 'pending') { %>
              <div class="d-grid gap-2">
                <form action="/bookings/<%= booking._id %>/confirm" method="POST" onsubmit="return confirm('Confirm this booking?')">
                  <button class="btn btn-success w-100">
                    <i class="fa-solid fa-check"></i> Confirm Booking
                  </button>
                </form>
                <form action="/bookings/<%= booking._id %>/reject" method="POST" onsubmit="return confirm('Reject this booking?')">
                  <button class="btn btn-danger w-100">
                    <i class="fa-solid fa-times"></i> Reject Booking
                  </button>
                </form>
              </div>
            <% } else if(booking.status === 'confirmed') { %>
              <div class="d-grid gap-2">
                <a href="/chat/booking/<%= booking._id %>" class="btn btn-primary">
                  <i class="fa-solid fa-comments"></i> Chat with Guest
                </a>
              </div>
            <% } %>
            <form action="/bookings/<%= booking._id %>/admin-delete?_method=DELETE" method="POST" class="mt-2" onsubmit="return confirm('Delete this booking?')">
              <button class="btn btn-outline-danger w-100">
                <i class="fa-solid fa-trash"></i> Delete
              </button>
            </form>
          </div>
        </div>
      <% } %>
    </div>
  <% } %>
</div>
