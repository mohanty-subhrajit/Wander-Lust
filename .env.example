# Environment Configuration Variables
# Copy this file to .env and fill in the required values

# Database
ATLASDB_URL=your_mongodb_atlas_url_here

# Session & Authentication
SECRET=your_secret_key_here

# Cloudinary Configuration (for image upload)
CLOUD_NAME=your_cloudinary_cloud_name
CLOUD_API_KEY=your_cloudinary_api_key
CLOUD_API_SECRET=your_cloudinary_api_secret

# Mapbox Configuration (for maps)
MAP_TOKEN=your_mapbox_access_token

# Email Configuration (GMAIL SMTP)
# Setup Instructions:
# 1. Go to https://myaccount.google.com/security
# 2. Enable "2-Step Verification" if not already enabled
# 3. Go to "App passwords" and generate a password
# 4. Select "Mail" and "Windows Computer" (or your device)
# 5. Copy the 16-character password below
GMAIL_USER=mohantysubhrajit22@gmail.com
GMAIL_PASSWORD=your_16_character_app_password_here

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Node Environment
NODE_ENV=development
PORT=10000
